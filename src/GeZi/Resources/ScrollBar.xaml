<!--
    ScrollBar.xaml —— 重写滚动条模板
    ============================================================
    规格要求：6px 宽圆角细条，默认半透明浅色，悬停加深。
    默认 WPF 滚动条又粗又带箭头按钮，与整体设计格格不入，所以整套重写。

    ⚠️ 只有垂直方向：全项目的 ScrollViewer 都把水平滚动条设为
       Disabled / Hidden（没有任何界面会显示横向滚动条），
       所以原先那套水平模板（ThinScrollBarHorizontal / AutoThinScrollBar）已删除。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ────────── 滑块（Thumb） -->
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Background="{DynamicResource ScrollThumbBrush}"
                            CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── 垂直滚动条 -->
    <Style x:Key="ThinScrollBarVertical" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <!-- 轨道本身完全透明，只有滑块可见 —— 视觉最轻 -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}"
                                       Width="6" HorizontalAlignment="Center"/>
                            </Track.Thumb>
                            <!-- 上下翻页区域也透明，点击空白即可翻页 -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                              Focusable="False" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                              Focusable="False" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ────────── 隐式样式：全局默认滚动条都变细 -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarVertical}"/>

</ResourceDictionary>
