<!--
    Brushes.xaml —— 设计令牌（画刷）
    ============================================================
    由 Colors.xaml 的颜色派生。界面里引用画刷（DynamicResource），
    而不是到处写 #FFxxxxxx 硬编码。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ────────── 背景 / 表面 -->
    <SolidColorBrush x:Key="AppBgBrush" Color="{DynamicResource AppBgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{DynamicResource SurfaceSunkenColor}"/>

    <!-- ────────── 实心主按钮（主题安全：浅色深底白字 / 深色浅底深字） -->
    <SolidColorBrush x:Key="SolidBtnBgBrush" Color="{DynamicResource SolidBtnBgColor}"/>
    <SolidColorBrush x:Key="SolidBtnFgBrush" Color="{DynamicResource SolidBtnFgColor}"/>

    <!-- ────────── 主色 -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{DynamicResource PrimarySoftColor}"/>

    <!-- ────────── 语义色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{DynamicResource WarningLightColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{DynamicResource DangerLightColor}"/>

    <!-- ────────── 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{DynamicResource TextOnPrimaryColor}"/>

    <!-- ────────── 描边 / 分隔 -->
    <SolidColorBrush x:Key="BorderBrushSoft" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderBrushStrong" Color="{DynamicResource BorderStrongColor}"/>

    <!-- ────────── 滚动条 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{DynamicResource ScrollThumbHoverColor}"/>

    <!-- ────────── 标题栏 -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="{DynamicResource TitleBarColor}"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="{DynamicResource TitleBarHoverColor}"/>
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="{DynamicResource TitleBarCloseHoverColor}"/>

    <!-- ────────── 头像底色 -->
    <SolidColorBrush x:Key="AvatarTint1Brush" Color="{DynamicResource AvatarTint1Color}"/>
    <SolidColorBrush x:Key="AvatarTint2Brush" Color="{DynamicResource AvatarTint2Color}"/>
    <SolidColorBrush x:Key="AvatarTint3Brush" Color="{DynamicResource AvatarTint3Color}"/>
    <SolidColorBrush x:Key="AvatarTint4Brush" Color="{DynamicResource AvatarTint4Color}"/>
    <SolidColorBrush x:Key="AvatarTint5Brush" Color="{DynamicResource AvatarTint5Color}"/>

    <!-- ────────── 容量色阶 -->
    <SolidColorBrush x:Key="CapacityLowBrush" Color="{DynamicResource CapacityLowColor}"/>
    <SolidColorBrush x:Key="CapacityMidBrush" Color="{DynamicResource CapacityMidColor}"/>
    <SolidColorBrush x:Key="CapacityHighBrush" Color="{DynamicResource CapacityHighColor}"/>

    <!-- 模态遮罩：居中浮层（解析历史面板）背后的压暗层。深浅两套值见 Colors.*.xaml -->
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}"/>

    <!-- 波纹：选项栏点击反馈（RippleEffect.cs 生成椭圆时取此刷子）。
         Color 是 DynamicResource → 主题切换自动换色，刷子实例不变。 -->
    <SolidColorBrush x:Key="RippleBrush" Color="{DynamicResource RippleColor}"/>

</ResourceDictionary>
