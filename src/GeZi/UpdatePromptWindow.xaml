<Window x:Class="GeZi.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="更新可用"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        「更新详情」窗口（2026-10-11 第三步）：用户点「检查更新」发现新版本后弹出。
        ⚠️ 跟关于/主窗一样走 WindowChrome（非分层窗口 → 文字清晰），圆角交给 DWM。
        ⚠️ CaptionHeight=44 让标题栏可拖动；关闭按钮要 IsHitTestVisibleInChrome。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
        <StackPanel>
            <!-- 标题栏 -->
            <Grid Height="44" Background="Transparent">
                <TextBlock Text="更新可用" Margin="18,0,44,0"
                           VerticalAlignment="Center"
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Button x:Name="CloseBtn" Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Width="30" Height="30"
                        Style="{StaticResource CaptionCloseButton}" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Stretch="Uniform" Width="11" Height="11"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <StackPanel Margin="20,4,20,20">
                <!-- 版本对比 -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="NewVersionText" Text="发现新版本 v?"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="CurrentVersionText" Text="当前版本 v?"
                                   FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                    <!-- 版本标签小色块（视觉上呼应"有新版本"）-->
                    <Border Grid.Column="1" VerticalAlignment="Center"
                            Background="{DynamicResource PrimaryBrush}" CornerRadius="6"
                            Padding="8,4" Margin="8,0,0,0">
                        <TextBlock x:Name="SizeText" Text="?" FontSize="11"
                                   Foreground="{DynamicResource SurfaceBrush}"/>
                    </Border>
                </Grid>

                <!-- 更新说明入口 -->
                <Button x:Name="ReleaseBtn" Click="OnReleaseClick"
                        AutomationProperties.Name="查看更新说明"
                        HorizontalAlignment="Left" Margin="0,10,0,0"
                        Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                    <TextBlock Text="查看更新说明（GitHub Releases）"
                               FontSize="11.5" TextDecorations="Underline"
                               Foreground="{DynamicResource PrimaryBrush}"/>
                </Button>

                <Rectangle Height="1" Fill="{DynamicResource BorderBrushSoft}" Margin="0,14,0,0"/>

                <!-- 未登录提示（需求第 7 条：未登录时提示「请登录后更新」）。
                     默认折叠，未登录时由代码显示 —— 不用 Visibility 绑定，保持与项目其它窗口一致。 -->
                <Border x:Name="LoginHintBox" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceSunkenBrush}"
                        CornerRadius="6" Padding="10,7" Margin="0,12,0,0">
                    <TextBlock x:Name="LoginHintText" Text="请登录后更新"
                               FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>

                <!-- 下载方式：**默认直接转存下载**，不再让用户二选一。
                     「免转存」只在两种情况下出现（都不在这里选）：
                       · 未登录 —— 无法转存，直接走免转存（上面的提示条已说明）；
                       · 网盘容量不足 —— 由主窗口弹提示，让用户决定清理网盘还是改用免转存。
                     ⚠️ 转存说明里**必须保留「60 小时后自动删除」**这句：用户会关心
                        网盘里是不是被塞了个长期占地的副本。 -->
                <TextBlock Text="下载方式" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"/>
                <TextBlock x:Name="ModeNote" Text="" Style="{StaticResource ProseText}"
                           TextWrapping="Wrap" FontSize="11.5"/>

                <!-- 底部按钮：左侧「忽略此版本」，右侧「暂不 / 开始下载」。
                     「忽略此版本」原来挂在「关于」页那层"是否查看详情"确认框的「否」上，
                     容易手滑把提醒永久屏蔽；现在挪到这里，要忽略必须明确点它。 -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="IgnoreBtn" Grid.Column="0" Content="忽略此版本" Click="OnIgnoreClick"
                            AutomationProperties.Name="忽略此版本"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="96" HorizontalAlignment="Left"
                            ToolTip="之后不再提示这个版本；想恢复：再点一次「检查更新」"/>
                    <Button x:Name="CancelBtn" Grid.Column="2" Content="暂不" Click="OnCloseClick"
                            AutomationProperties.Name="暂不更新"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="84" Margin="0,0,10,0"/>
                    <Button x:Name="DownloadBtn" Grid.Column="3" Content="开始下载" Click="OnDownloadClick"
                            AutomationProperties.Name="开始下载更新"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="96"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
